DATABASE_URL=sqlite:///./saqta.db
# PostgreSQL example: postgresql+psycopg://saqta:YOUR_PASSWORD@localhost:5432/saqta
WORKSPACE_MODE=real
# Real accounts are isolated from any archived synthetic workspace. Session tokens are
# hashed in the DB; passwords use salted scrypt. No administrator password exists.
AUTH_SESSION_HOURS=168
AUTH_REGISTRATION_ENABLED=true
# Empty disables /api/admin. Use a unique random token; keep it server-side.
ADMIN_TOKEN=
# Process-local limits, cleared on restart; use one API process locally.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_PICKUP_MAX_ATTEMPTS=5
RATE_LIMIT_PICKUP_WINDOW_SECONDS=300
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECONDS=3600
# Opt in only for an isolated public demo. Seeds an empty database once after
# migrations; preserves existing data and refuses real-data workspaces.
AUTO_SEED_DEMO=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SAQTA_TIMEZONE=Asia/Qyzylorda
# Optional reproducible date anchor. Without it, seeds end on the local current date.
# DEMO_ANCHOR_DATE=2026-10-24

# Forecast is a paid plan (Starter 15 000 ₸ / Pro 30 000 ₸ per month); new business accounts get a trial.
FORECAST_REQUIRES_SUBSCRIPTION=true
TRIAL_DAYS=14
# Public site address used in emails (password reset and invoice links).
PUBLIC_URL=http://localhost:3000

# --- Card payments: TipTop Pay (https://developers.tiptoppay.kz). Empty = card payment off.
# Notification URLs to set in the TipTop cabinet (POST, form or JSON):
#   Check  -> https://<api>/api/billing/tiptop/check
#   Pay    -> https://<api>/api/billing/tiptop/pay
#   Fail   -> https://<api>/api/billing/tiptop/fail
#   Recurrent -> https://<api>/api/billing/tiptop/recurrent
TIPTOP_PUBLIC_ID=
TIPTOP_API_SECRET=
BILLING_TEST_MODE=true
# Local demo only: pay through a built-in test button. Ignored while TipTop keys are set.
BILLING_SIMULATOR=false

# --- Invoice (bank transfer / Kaspi) requisites shown on the printable invoice.
# Transfer payment is off until name, BIN, IBAN and bank are filled.
SELLER_NAME=
SELLER_BIN=
SELLER_ADDRESS=
SELLER_IBAN=
SELLER_BANK=
SELLER_BIK=
SELLER_KBE=19
SELLER_EMAIL=
SELLER_PHONE=
SELLER_VAT_PAYER=false
INVOICE_DUE_DAYS=5

# --- Email (password reset, invoices, receipts, reminders). Empty SMTP_HOST = log only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=SaqtaFood <no-reply@saqta.kz>
PASSWORD_RESET_MINUTES=60
# Optional self-hosted OpenAI-compatible Qwen endpoint. Empty means deterministic explanations.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-0.6B
