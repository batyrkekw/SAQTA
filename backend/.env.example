DATABASE_URL=sqlite:///./saqta.db
# PostgreSQL example: postgresql+psycopg://saqta:YOUR_PASSWORD@localhost:5432/saqta
WORKSPACE_MODE=real
# Real accounts are isolated from any archived synthetic workspace. Session tokens are
# hashed in the DB; passwords use salted scrypt. No administrator password exists.
AUTH_SESSION_HOURS=168
AUTH_REGISTRATION_ENABLED=true
# Empty disables /api/admin. Use a unique random token; keep it server-side.
ADMIN_TOKEN=
# Process-local limits, cleared on restart; use one API process locally.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_PICKUP_MAX_ATTEMPTS=5
RATE_LIMIT_PICKUP_WINDOW_SECONDS=300
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECONDS=3600
# Opt in only for an isolated public demo. Seeds an empty database once after
# migrations; preserves existing data and refuses real-data workspaces.
AUTO_SEED_DEMO=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SAQTA_TIMEZONE=Asia/Qyzylorda
# Optional reproducible date anchor. Without it, seeds end on the local current date.
# DEMO_ANCHOR_DATE=2026-10-24

# Forecast is free. Legacy subscription records remain intact.
FORECAST_REQUIRES_SUBSCRIPTION=false
# Optional self-hosted OpenAI-compatible Qwen endpoint. Empty means deterministic explanations.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-0.6B
