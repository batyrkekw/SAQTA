DATABASE_URL=sqlite:///./saqta.db
# PostgreSQL example: postgresql+psycopg://saqta:YOUR_PASSWORD@localhost:5432/saqta
WORKSPACE_MODE=demo
# Real organizations require a separate real-mode deployment. Session tokens are
# hashed in the DB; passwords use salted scrypt. No administrator password exists.
AUTH_SESSION_HOURS=168
AUTH_REGISTRATION_ENABLED=true
# Opt in only for an isolated public demo. Seeds an empty database once after
# migrations; preserves existing data and refuses real-data workspaces.
AUTO_SEED_DEMO=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SAQTA_TIMEZONE=Asia/Qyzylorda
# Optional reproducible date anchor. Without it, seeds end on the local current date.
# DEMO_ANCHOR_DATE=2026-10-24
